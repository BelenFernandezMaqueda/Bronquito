# Copiá este archivo a ".env" (sin ".example") antes de levantar el proyecto.
# El ".env" real NO se sube a git (mirá .gitignore) porque tiene contraseñas.

MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_DATABASE=bronquito
MYSQL_USER=bronquito
MYSQL_PASSWORD=changeme_bronquito

# Estos tres reflejan los de arriba: docker-compose los usa para armar la
# variable de conexión que recibe el backend (ver app/core/config.py).
MYSQL_HOST=db
MYSQL_PORT=3306

# Usada para firmar los tokens de login (JWT) — ver app/core/security.py.
# Para un proyecto real, generá un valor largo y random (por ejemplo con
# `openssl rand -hex 32`) y no lo compartas fuera del equipo.
JWT_SECRET_KEY=changeme_jwt_secret

# --- Envío de mails ----------------------------------------------------------
# Por defecto el backend le manda TODOS los mails a "mailpit", un servidor
# SMTP falso que corre en Docker y NO envía nada de verdad: los ves en
# http://localhost:8025. Para desarrollo no necesitás tocar nada de acá abajo.
#
# Para mandar mails REALES con una cuenta de Gmail dedicada al proyecto:
#   1. Creá la cuenta de Gmail y activá la verificación en 2 pasos.
#   2. Generá una "contraseña de aplicación" (App Password) de 16 caracteres
#      en https://myaccount.google.com/apppasswords
#   3. Descomentá y completá lo siguiente (y NO subas este archivo con la
#      contraseña real — el .env está en .gitignore):
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_USER=bronquito.proyecto@gmail.com
# SMTP_PASSWORD=abcdabcdabcdabcd          # la App Password, sin espacios
# EMAIL_FROM=Bronquito <bronquito.proyecto@gmail.com>
#
# EMAIL_ENABLED=false  ->  desactiva el envío (sólo loguea). Default: true.
#
# FRONTEND_URL se usa para armar los links de los mails (verificar mail,
# resetear contraseña). En dev es el server de Vite:
# FRONTEND_URL=http://localhost:5173
